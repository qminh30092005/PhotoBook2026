# Chép file này thành .env khi build trên máy. Trên Vercel: Settings → Environment Variables (cùng tên).
# Ô nào để trống thì tính năng đó tự tắt. KHÔNG để mật khẩu admin ở đây (nó nằm trong Script Properties của Apps Script).

# Link Web app của Apps Script, dạng https://script.google.com/macros/s/XXXX/exec  (trống = web chạy chế độ thử, mã thử DEMO10)
API_URL=
# Link web chính thức. Trên Vercel để trống thì tự lấy domain production của project.
SITE_URL=
# Mã ngân hàng VietQR: vcb, tcb, mb, acb… (vietqr.io/danh-sach-ngan-hang)
BANK_ID=
ACCOUNT_NO=
# VIẾT HOA KHÔNG DẤU, vd NGUYEN VAN A
ACCOUNT_NAME=
SHOP_ZALO=
# Không cần @
SHOP_INSTAGRAM=
META_PIXEL_ID=
# vd G-XXXXXXXXXX
GA4_ID=

# Cấu hình công khai của Firebase Web App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Email shop nhận yêu cầu về dữ liệu cá nhân
SHOP_PRIVACY_EMAIL=
